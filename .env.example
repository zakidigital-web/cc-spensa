# Database Connection (Neon / Vercel Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xxxx.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Postgres Format
POSTGRES_URL=postgresql://neondb_owner:password@ep-xxxx.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_HOST=ep-xxxx.c-14.us-east-1.aws.neon.tech
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=neondb
